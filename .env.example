# --- server ---
PORT=8080
PUBLIC_URL=http://localhost:8080          # base for stream_url / cancel_url / result_url
ENGINE_TOKEN=                             # REQUIRED: Bearer for POST /runs, GET, cancel; several — comma-separated
ALLOWED_ORIGINS=http://localhost:3000     # CORS for browsers subscribing to SSE directly (comma-separated)

# --- egress (SPEC §11.4): where the engine may go for tools / callback / base_url ---
EGRESS_ALLOWLIST=api.example.com,.example.com   # exact host or .suffix for subdomains, comma-separated
ALLOW_INSECURE_EGRESS=1                   # 1 — allow http://localhost (development only)

# --- resources ---
MAX_CONCURRENT_RUNS=32
MAX_REQUEST_BYTES=1048576                 # body of POST /runs and other incoming requests
TOOL_RESPONSE_MAX_BYTES=1048576           # cap on reading a tool response (streamed)
SSE_BUFFER_MAX_BYTES=2097152              # per-run event buffer for replay
RUN_RETENTION_MS=600000                   # keep a finished run for stream / GET
RUN_RETENTION_UNACKED_MS=3600000          # the same while the harness has not sent ack (SPEC §3.1)
MAX_RETAINED_RUNS=1000                    # global cap of finished runs in memory
MAX_RETAINED_BYTES=268435456              # and by bytes (256 MB); undelivered runs are not evicted
CALLBACK_ATTEMPT_TIMEOUT_MS=10000         # timeout of one callback attempt
CALLBACK_SECRET=                          # callback signature: header X-Engine-Secret, checked by the receiving endpoint (SPEC §7)
ERROR_WEBHOOK_URL=                        # error webhook: callback_failed / run_failed / ack_missing / … (SPEC §12.3); https, host in EGRESS_ALLOWLIST
IMAGE_MAX_BYTES=5242880                   # cap of an image (data: or downloaded)
SHUTDOWN_GRACE_MS=7000                    # SIGTERM: wait for in-flight runs; below Docker's 10 s default before SIGKILL
MAX_CONTEXT_FALLBACK=128000               # model window when not passed and no profile exists
ENGINE_LOCALE=en                          # en | ru — engine-injected text when meta.locale is absent (SPEC Appendix B)
DEFAULT_TIMEZONE=UTC                      # time zone of dates without meta.timezone (SPEC §9.4), IANA

# --- provider queue and 429 retries (SPEC §11.3, §11.6) ---
PROVIDER_THROTTLE=1                       # 0 — no queue and no AIMD (429 retries stay)
PROVIDER_MAX_CONCURRENCY_DEFAULT=16       # ceiling of parallel calls per provider key
PROVIDER_MAX_CONCURRENCY_GIGACHAT=6       # a key's actual limit is ~10 concurrent streams; likewise _ANTHROPIC / _OPENAI / _DEEPSEEK / _MINIMAX / _OPENAI_COMPATIBLE
PROVIDER_MAX_CONCURRENCY_GLM=4            # z.ai caps concurrency by account plan, 429 already at 5+
PROVIDER_QUEUE_TIMEOUT_MS=60000           # max wait for a slot; cut by the run's remaining timeout_ms
PROVIDER_THROTTLE_COOLDOWN_MS=1000        # pause in granting slots after a 429 (a longer Retry-After wins)
PROVIDER_THROTTLE_INCREASE_AFTER=10       # this many successes in a row — ceiling +1, up to PROVIDER_MAX_CONCURRENCY_*
PROVIDER_RATE_LIMIT_RETRIES=5             # retries on 429 (network / 5xx get 2)
PROVIDER_RATE_LIMIT_BACKOFF_MS=1000       # full-jitter backoff base without Retry-After
PROVIDER_RATE_LIMIT_MAX_DELAY_MS=16000    # cap of backoff and of the pause after a 429

# --- logs (SPEC §12.2, §12.4) ---
LOG_LEVEL=info                            # stdout level; the GET /logs journal records every level
LOG_PROMPTS=0                             # 1 — event content (prompt, texts, tool args/results) in stdout too (local only)
LOG_BUFFER_MAX_ENTRIES=20000              # in-memory event journal for GET /logs; 0 — off
LOG_BUFFER_MAX_BYTES=33554432             # journal cap in bytes (32 MB)
LOG_BUFFER_CONTENT=1                      # 0 — metadata only in the journal, no content
LOG_CONTENT_MAX_CHARS=4000                # cap of one content field, memory and stdout
# LOG_DIR=/var/lib/theloop/journal        # journal on disk, survives restarts; needs a persistent volume
LOG_RETENTION_DAYS=7                      # day files older than this are deleted; 0 — today only
LOG_DIR_MAX_BYTES=2147483648              # disk journal ceiling (2 GB), oldest days go first
LOG_DISK_CONTENT_MAX_CHARS=200000         # cap of one content field on disk

# --- providers: fallback when llm.api_key is not passed in the request (SPEC §9.1) ---
# Used ONLY with the built-in base_url of a named provider, never with openai-compatible.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
MINIMAX_API_KEY=                          # platform.minimax.io → API Keys (pay-as-you-go), not a key from the China platform

# --- provider proxies (SPEC §11.4): where Anthropic / OpenAI are not reachable directly they answer 403 ---
# http://user:pass@host:port | https://… | socks5://… (socks5 in undici is experimental —
# prefer http). TLS to the provider is end-to-end, the proxy never sees the key. There are also DEEPSEEK_ / GLM_ / MINIMAX_ /
# GIGACHAT_PROXY_URL; openai-compatible always goes directly.
ANTHROPIC_PROXY_URL=
OPENAI_PROXY_URL=

# GigaChat: the "authorization key" from the developer console (Basic) + scope; the engine obtains the OAuth token itself
# GIGACHAT_SCOPE is the default, overridden by llm.gigachat_scope in the request (PERS | B2B | CORP)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# GigaChat TLS: the Russian Trusted Root CA is set at startup, not here (see certs/README.md):
#   NODE_EXTRA_CA_CERTS=certs/russian_bundle.pem npm run dev
